{
  "name": "emotional-head",
  "version": "0.1.0",
  "description": "Emotional 3D talking head for the web: Three.js, 52 ARKit blendshapes, layered emotions, lip-sync, avatar from a photo, glTF export",
  "keywords": [
    "three",
    "threejs",
    "talking-head",
    "avatar",
    "arkit",
    "blendshapes",
    "lip-sync",
    "emotions",
    "webgl",
    "gltf",
    "face"
  ],
  "homepage": "https://taxoin.github.io/Anima/",
  "bugs": {
    "url": "https://github.com/taxoin/Anima/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taxoin/Anima.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "src/emotional-head.js",
  "types": "src/emotional-head.d.ts",
  "exports": {
    ".": {
      "types": "./src/emotional-head.d.ts",
      "default": "./src/emotional-head.js"
    },
    "./element": {
      "types": "./src/element.d.ts",
      "default": "./src/element.js"
    },
    "./emotions": {
      "types": "./src/emotions.d.ts",
      "default": "./src/emotions.js"
    },
    "./lipsync": {
      "types": "./src/lipsync.d.ts",
      "default": "./src/lipsync.js"
    },
    "./min": "./dist/emotional-head.min.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./src/element.js"
  ],
  "peerDependencies": {
    "three": ">=0.163.0"
  },
  "scripts": {
    "serve": "npx serve .",
    "build": "npx esbuild src/element.js --bundle --minify --format=esm --external:three --external:three/addons/* --outfile=dist/emotional-head.min.js",
    "test:visual": "node tests/visual.mjs",
    "test:likeness": "node tests/likeness.mjs",
    "fetch:portraits": "node tests/fetch-portraits.mjs",
    "test:detect": "node tests/detect.mjs",
    "test:types": "tsc -p tests/types/tsconfig.json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.6.3"
  }
}
